MONGODB_URI=
PORT=3000
FRONTEND_URL=http://localhost:5173
# Optional Node-only DNS override when the system resolver cannot resolve Atlas SRV records.
DNS_SERVERS=

# Two different random secrets, at least 32 bytes each. Never expose in frontend env.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Optional future integrations; Gemini is required by the existing deploy script.
GEMINI_API_KEY=
GEMINI_MODEL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
